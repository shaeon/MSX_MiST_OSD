# MSX1 for Calypso (Cyclone 10 LP 10CL025YU256C8G)
# Port of the MiST project by Shaeon (Carlos Palmero)
set_global_assignment -name FAMILY "Cyclone 10 LP"
set_global_assignment -name DEVICE 10CL025YU256C8G
set_global_assignment -name DEVICE_FILTER_PACKAGE FBGA
set_global_assignment -name DEVICE_FILTER_PIN_COUNT 256
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
set_global_assignment -name LAST_QUARTUS_VERSION "17.0.0 Lite Edition"
set_global_assignment -name VERILOG_MACRO "BOARD_CLOCK_12=1"
set_global_assignment -name VERILOG_MACRO "VGA_4BIT=1"
set_global_assignment -name VERILOG_MACRO "SDRAM_16MB=1"
set_global_assignment -name VERILOG_MACRO "I2S_AUDIO=1"
set_global_assignment -name VERILOG_MACRO "USE_AUDIO_IN=1"
set_global_assignment -name VERILOG_MACRO "NO_ANALOG_AUDIO=1"
set_global_assignment -name VERILOG_MACRO "NO_UART=1"
set_global_assignment -name VERILOG_MACRO "NO_DIRECT_UPLOAD=1"
set_global_assignment -name VERILOG_MACRO "BIG_OSD=1"
set_global_assignment -name VERILOG_MACRO "MSX1_CORE=1"

